@model Warehouse_23DH111747.Models.Product
@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-4 gap-2">
    <h4 class="fw-bold text-danger mb-0">
        Xóa Sản Phẩm
    </h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        &larr; Danh sách sản phẩm
    </a>
</div>

<div class="card border p-4 shadow-sm" style="max-width: 600px;">
    <p class="fs-6 mb-3">Bạn có chắc chắn muốn xóa sản phẩm này khỏi kho?</p>

    <dl class="row mb-4">
        <dt class="col-sm-4">Mã sản phẩm:</dt>
        <dd class="col-sm-8 fw-bold">@Model.ProductID</dd>

        <dt class="col-sm-4">Tên sản phẩm:</dt>
        <dd class="col-sm-8 fw-semibold">@Model.ProductName</dd>

        <dt class="col-sm-4">Danh mục:</dt>
        <dd class="col-sm-8">@Model.Category</dd>

        <dt class="col-sm-4">Đơn giá:</dt>
        <dd class="col-sm-8 text-primary fw-bold">@Model.Price.ToString("N2") đ</dd>

        <dt class="col-sm-4">Số lượng:</dt>
        <dd class="col-sm-8 fw-bold">@Model.Quantity (<span class="badge @Model.StockBadgeClass">@Model.StockStatus</span>)</dd>
    </dl>

    <form asp-action="Delete" method="post" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ProductID" value="@Model.ProductID" />
        <button type="submit" class="btn btn-danger px-4 fw-bold">
            Xác nhận xóa
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            Hủy
        </a>
    </form>
</div>
