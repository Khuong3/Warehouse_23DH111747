@model Warehouse_23DH111747.Models.DualInventoryCheckViewModel
@{
    ViewData["Title"] = "Kiểm kê đồng thời 2 sản phẩm";
}

<div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-4 gap-2">
    <h4 class="fw-bold text-primary mb-0">
        Kiểm Kê Đồng Thời Hai Sản Phẩm
    </h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        &larr; Danh sách sản phẩm
    </a>
</div>

@if (Model.IsSubmitted && !Model.IsSuccess)
{
    <div class="alert alert-danger border-start border-5 border-danger shadow-sm">
        @Model.ErrorMessage
    </div>
}

@if (Model.IsSubmitted && Model.IsSuccess)
{
    <div class="alert alert-success border-start border-5 border-success shadow-sm">
        <h6 class="fw-bold mb-2">Cập nhật số lượng thành công:</h6>
        <ul class="mb-0">
            <li>
                <strong>#@Model.ProductID1 - @Model.Product1Name:</strong>
                @Model.OldQuantity1 &rarr; <strong class="text-primary">@Model.NewQuantity1</strong> (@Model.DiffStatus1)
            </li>
            <li>
                <strong>#@Model.ProductID2 - @Model.Product2Name:</strong>
                @Model.OldQuantity2 &rarr; <strong class="text-primary">@Model.NewQuantity2</strong> (@Model.DiffStatus2)
            </li>
        </ul>
    </div>
}

<form asp-action="DualInventoryCheck" method="post" class="card bg-light border p-4 mb-4 shadow-sm">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border h-100">
                <div class="card-header bg-primary text-white fw-bold">
                    Sản phẩm thứ nhất
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn sản phẩm:</label>
                        <select class="form-select form-select-sm mb-2" onchange="document.getElementById('inputPid1').value = this.value;">
                            <option value="">-- Chọn sản phẩm --</option>
                            @foreach (var p in Model.Products)
                            {
                                <option value="@p.ProductID" selected="@(Model.ProductID1 == p.ProductID)">
                                    #@p.ProductID - @p.ProductName (Tồn: @p.Quantity)
                                </option>
                            }
                        </select>
                        <label class="form-label fw-bold small text-secondary">Mã sản phẩm 1:</label>
                        <input type="number" id="inputPid1" name="ProductID1" value="@Model.ProductID1" class="form-control" required />
                    </div>
                    <div>
                        <label class="form-label fw-bold">Số lượng thực tế 1:</label>
                        <input type="text" name="RawQuantity1" value="@Model.RawQuantity1" class="form-control" required />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border h-100">
                <div class="card-header bg-info text-dark fw-bold">
                    Sản phẩm thứ hai
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn sản phẩm:</label>
                        <select class="form-select form-select-sm mb-2" onchange="document.getElementById('inputPid2').value = this.value;">
                            <option value="">-- Chọn sản phẩm --</option>
                            @foreach (var p in Model.Products)
                            {
                                <option value="@p.ProductID" selected="@(Model.ProductID2 == p.ProductID)">
                                    #@p.ProductID - @p.ProductName (Tồn: @p.Quantity)
                                </option>
                            }
                        </select>
                        <label class="form-label fw-bold small text-secondary">Mã sản phẩm 2:</label>
                        <input type="number" id="inputPid2" name="ProductID2" value="@Model.ProductID2" class="form-control" required />
                    </div>
                    <div>
                        <label class="form-label fw-bold">Số lượng thực tế 2:</label>
                        <input type="text" name="RawQuantity2" value="@Model.RawQuantity2" class="form-control" required />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 text-end">
        <button type="submit" class="btn btn-primary px-4 fw-bold">
            Cập nhật đồng thời
        </button>
    </div>
</form>

<h6 class="fw-bold text-dark mb-3">Danh sách sản phẩm</h6>
<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle mb-0">
        <thead>
            <tr class="text-center">
                <th style="width: 90px;">Mã SP</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th style="width: 150px;">Đơn giá</th>
                <th style="width: 130px;">Số lượng</th>
                <th style="width: 140px;">Tình trạng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                bool isHighlighted = Model.IsSubmitted && Model.IsSuccess &&
                                     (item.ProductID == Model.ProductID1 || item.ProductID == Model.ProductID2);
                <tr class="@(isHighlighted ? "table-success" : "")">
                    <td class="text-center fw-bold">@item.ProductID</td>
                    <td class="fw-semibold">@item.ProductName</td>
                    <td>@item.Category</td>
                    <td class="text-end fw-semibold text-primary">@item.Price.ToString("N2") đ</td>
                    <td class="text-center fw-bold">@item.Quantity</td>
                    <td class="text-center">
                        <span class="badge @item.StockBadgeClass px-3 py-2">@item.StockStatus</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
