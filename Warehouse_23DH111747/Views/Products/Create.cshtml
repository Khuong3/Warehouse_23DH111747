@model Warehouse_23DH111747.Models.ProductCreateViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    var errorList = ViewBag.ErrorList as List<string>;
    var categories = ViewBag.Categories as List<Warehouse_23DH111747.Models.CategoryItem> ?? new List<Warehouse_23DH111747.Models.CategoryItem>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-4 gap-2">
    <h4 class="fw-bold text-primary mb-0">
        Thêm Sản Phẩm Mới
    </h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        &larr; Danh sách sản phẩm
    </a>
</div>

@if (errorList != null && errorList.Any())
{
    <div class="alert alert-danger border-start border-5 border-danger shadow-sm">
        <ul class="mb-0">
            @foreach (var err in errorList)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

<form asp-action="Create" method="post" class="card border p-4 shadow-sm" style="max-width: 700px;">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
        <input type="text" name="ProductName" value="@Model.ProductName" class="form-control" placeholder="Nhập tên sản phẩm..." />
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label fw-bold mb-0">Danh mục <span class="text-danger">*</span></label>
            <a asp-controller="Categories" asp-action="Create" class="small text-decoration-none">+ Thêm danh mục mới</a>
        </div>
        <select name="Category" class="form-select">
            <option value="">-- Chọn danh mục --</option>
            @foreach (var c in categories)
            {
                <option value="@c.CategoryName" selected="@(Model.Category == c.CategoryName)">
                    @c.CategoryName
                </option>
            }
        </select>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="form-label fw-bold">Đơn giá <span class="text-danger">*</span></label>
            <input type="number" step="0.01" name="RawPrice" value="@Model.RawPrice" class="form-control" placeholder="Nhập đơn giá..." />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Số lượng <span class="text-danger">*</span></label>
            <input type="text" name="RawQuantity" value="@Model.RawQuantity" class="form-control" placeholder="Nhập số lượng..." />
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success px-4 fw-bold">
            Lưu sản phẩm
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            Hủy
        </a>
    </div>
</form>
